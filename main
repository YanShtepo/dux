function dropTarget(e){return e.target.closest&&(e.target.closest('.lp,.lpad')||e.target.closest('.rr.rg'))}
TV.addEventListener('dragover',e=>{const t=dropTarget(e);if(t){e.preventDefault();t.classList.add('dropping')}});
