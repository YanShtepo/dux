  if(lx){const id=+lx.dataset.x;TR.exSel.has(id)?TR.exSel.delete(id):TR.exSel.add(id);lx.classList.toggle('xs',TR.exSel.has(id));updateBar();return}
  const li=e.target.closest('.lxi');
  if(li){const id=+li.dataset.x;TR.exSel.has(id)?TR.exSel.delete(id):TR.exSel.add(id);draw();updateBar();return}
  const lc=e.target.closest('.lp,.lpad');
  if(lc){const c=lc.dataset.c;TR.tgC=TR.tgC===c?null:c;draw();updateBar();updateInfo()}});
/* перетаскивание: № строки → позиция договора (связать) или группа заказной (вложить) */
TV.addEventListener('dragstart',e=>{
  const rn=e.target.closest&&e.target.closest('.rn');if(!rn)return;const id=rn.closest('.rr').dataset.o;
  if(!TR.sel.has(id)){TR.sel.clear();TR.sel.add(id);draw();updateBar()}
