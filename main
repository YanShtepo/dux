$('tFlt').addEventListener('change',e=>{TR.flt=e.target.value;relines()});
$('tQ').addEventListener('input',e=>{TR.q=e.target.value;relines()});
TV.addEventListener('input',e=>{
  const f=e.target.dataset&&e.target.dataset.f,row=e.target.closest&&e.target.closest('.rr');if(!f||!row)return;
  const o=TR.OM.get(row.dataset.o);if(!o)return;
  o[f]=f==='qty'?Number(e.target.value):e.target.value;TR.bm=new Map();
