<script>
/* ===================== DATA GENERATION (демо: 50 000 строк) ===================== */
const ROW_H=30;
const SEC=['Оповещение и связь','Кабельная продукция','Коммутация','Электроустановочные изделия','Щитовое оборудование','Крепёж и метизы','Лотки и короба','Структурированные кабельные системы','Видеонаблюдение','СКУД','Пожарная сигнализация','Источники питания','Серверное оборудование','Активное сетевое оборудование','Пассивное оборудование','Монтажные материалы','Заземление','Освещение','Датчики','Громкоговорители','Усилители','Пульты','Аккумуляторы','Шкафы и стойки','Расходные материалы'];
const T=[['KPS','Кабель КПСЭнг(A)-FRLS 2х2х0,5','м','ИЭК'],['KOR','Короб пластиковый кабельный','м','DKC'],['AVT','Автоматический выключатель','шт.','ABB'],['RZT','Розетка накладная','шт.','Legrand'],['GRM','Громкоговоритель рупорный AR','шт.','Армтел ООО'],['NCU','Модуль контроля линий NCU','шт.','Армтел ООО'],['TDA','Усилитель мощности TDA','шт.','Армтел ООО'],['PTC','Патч-корд UTP cat.6','шт.','Hyperline'],['SWT','Коммутатор управляемый','шт.','Eltex'],['CAM','IP-камера купольная','шт.','Hikvision'],['DTC','Датчик дымовой','шт.','Болид'],['BPT','Блок питания 12В','шт.','Рубикон'],['AKB','Аккумулятор 12В','шт.','Delta'],['LTK','Лоток перфорированный','м','DKC'],['DUB','Дюбель-гвоздь','шт.','Fischer'],['SHK','Шкаф телекоммуникационный','шт.','ЦМО'],['SVT','Светильник аварийный','шт.','Varton'],['ZZM','Шина заземления','шт.','ИЭК'],['RLE','Модуль реле NCU-REL','шт.','Армтел ООО'],['PLT','Пульт диспетчерский TOP-DIS','шт.','Армтел ООО']];
const norm=s=>String(s||'').replace(/\s+/g,'').toUpperCase();
const S={tab:'mark',rows:[],secs:[],roots:[],sel:new Set(),anchor:-1,filter:'all',q:'',view:[],target:null,exp:new Set(),eng:null,eq:'',efree:false};
const idx=new Map(); let NID=0, OID=0;
const catalog=new Map(); let catArr=[];

(function gen(){
  let code=10000;
  T.forEach(t=>{for(let v=0;v<250;v++){ if((v*7+t[0].charCodeAt(0))%4===0)continue;
    const it={code:String(code++),art:t[0]+'-'+(1000+v),manuf:t[3],name:t[1]+' тип '+v,unit:t[2]}; catalog.set(norm(it.art),it);} });
  catArr=[...catalog.values()];
  SEC.forEach((n,i)=>S.secs.push({id:i,name:n,rows:[]}));
  const N=50000,per=2000;
  for(let i=0;i<N;i++){
    const s=(i/per)|0,k=i%8,v=(i>>3)%250,t=T[(s*3+k)%20];
    let art=t[0]+'-'+(1000+v), manuf=t[3], name=t[1]+' тип '+v+(i%11===0?' (замена)':'');
    let dirty=false;
    if(i%23===0){art=art.toLowerCase()+' ';dirty=true}
    if(i%37===0){art='';dirty=true}
    if(i%29===0){manuf='';dirty=true}
    const qty=(1+(i*13)%40)*(t[2]==='м'?10:1);
    const r={id:i,sec:s,n:i+1,art,manuf,name,unit:t[2],qty,links:[],dirty,s:(art+' '+name+' '+manuf).toLowerCase()};
    S.rows.push(r);S.secs[s].rows.push(r);
  }
})();

/* ===================== HELPERS ===================== */
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;');
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('show');clearTimeout(window._tt);window._tt=setTimeout(()=>t.classList.remove('show'),2400)}
const fmt=n=>n.toLocaleString('ru-RU');
function sub(n,set){set.add(n.id);n.ch.forEach(c=>sub(c,set))}
function cntRec(n){let c=n.rows.length;for(const k of n.ch)c+=cntRec(k);return c}
function mkNode(o){return Object.assign({id:'n'+(++NID),kind:'p',name:'',unit:'шт.',qty:1,rows:[],ch:[],hidden:false,hideKids:false,orders:[],p:null,strict:false},o)}
function addChild(parent,n){if(parent){n.p=parent.id;parent.ch.push(n);S.exp.add(parent.id)}else{n.p=null;S.roots.push(n)}idx.set(n.id,n);return n}
function linkRows(n,ids){let c=0;for(const id of ids){const r=S.rows[id];if(!r.links.includes(n.id)){r.links.push(n.id);n.rows.push(id);c++}}return c}
function unlinkRows(n,ids){const s=new Set(ids);n.rows=n.rows.filter(id=>!s.has(id));ids.forEach(id=>{const r=S.rows[id];r.links=r.links.filter(x=>x!==n.id)})}
function removeNode(n){n.ch.slice().forEach(removeNode);unlinkRows(n,n.rows.slice());idx.delete(n.id);const arr=n.p?idx.get(n.p).ch:S.roots;arr.splice(arr.indexOf(n),1);if(S.target===n.id)S.target=null}
function insertParent(){const tn=idx.get(S.target);if(!tn)return null;return tn.kind==='g'?tn:(idx.get(tn.p)||null)}
function resetAll(){S.rows.forEach(r=>r.links=[]);S.roots=[];idx.clear();S.exp.clear();S.target=null;S.sel.clear()}

/* ===================== STATS ===================== */
function updateStats(){
  let a=0;for(const r of S.rows)if(r.links.length)a++;
  const N=S.rows.length;
  $('stat').textContent=`Распределено ${fmt(a)} из ${fmt(N)} строк · без связи: ${fmt(N-a)}`;
  $('statBar').style.width=(a/N*100)+'%';
  $('rcount').textContent=idx.size?`${fmt(idx.size)} поз.`:'';
}

/* ===================== LEFT: virtual list ===================== */
function refreshView(){
  const q=S.q.trim().toLowerCase();let ts=null;
  if(S.filter==='target'&&S.target&&idx.get(S.target)){ts=new Set();sub(idx.get(S.target),ts)}
  const out=[];
  for(const sec of S.secs){
    const st=out.length;out.push({t:'s',sec,cnt:0});let c=0;
    for(const r of sec.rows){
      if(q&&!r.s.includes(q))continue;
      if(S.filter==='free'&&r.links.length)continue;
      if(S.filter==='linked'&&!r.links.length)continue;
      if(S.filter==='target'&&!(ts&&r.links.some(l=>ts.has(l))))continue;
      out.push({t:'r',r});c++;
    }
    if(!c)out.length=st;else out[st].cnt=c;
  }
  S.view=out;
  $('vsp').style.height=out.length*ROW_H+'px';
  const n=out.filter(x=>x.t==='r').length;
  $('lcount').textContent=`показано ${fmt(n)} строк`;
  renderVL();
}
function renderVL(){
  const vl=$('vl'),st=vl.scrollTop,h=vl.clientHeight||600;
  const a=Math.max(0,Math.floor(st/ROW_H)-8),b=Math.min(S.view.length,Math.ceil((st+h)/ROW_H)+8);
  let html='';
  for(let i=a;i<b;i++){
    const it=S.view[i];
    if(it.t==='s'){
      let done=0,sel=0;for(const r of it.sec.rows){if(r.links.length)done++;if(S.sel.has(r.id))sel++}
      html+=`<div class="vr sec" data-i="${i}"><input type="checkbox" tabindex="-1" ${sel&&sel===it.sec.rows.length?'checked':''}><b>${esc(it.sec.name)}</b><span>${fmt(it.cnt)} строк</span><span>распределено ${fmt(done)} / ${fmt(it.sec.rows.length)}</span></div>`;
    }else{
      const r=it.r,l=r.links.length;
      html+=`<div class="vr r ${S.sel.has(r.id)?'sel':''}" data-i="${i}" draggable="true">
        <input type="checkbox" tabindex="-1" ${S.sel.has(r.id)?'checked':''}>
        <span class="mono" style="color:var(--faint)">${r.n}</span>
        <span class="mono ${r.art&&r.art!==r.art.trim()||/[a-z]/.test(r.art)?'':''}">${r.art?(r.dirty&&r.art!==r.art.toUpperCase().trim()?`<span class="dirty" title="Нестандартный формат">${esc(r.art)}</span>`:esc(r.art)):'<span class="dirty">нет</span>'}</span>
        <span>${r.manuf?esc(r.manuf):'<span class="dirty">нет</span>'}</span>
        <span title="${esc(r.name)}">${esc(r.name)}</span><span>${esc(r.unit)}</span><span class="mono" style="text-align:right">${r.qty}</span>
        <span class="chip ${l===0?'no':l>1?'multi':'ok'}">${l===0?'—':l>1?l+' поз.':'✓'}</span></div>`;
    }
  }
  $('vwin').style.transform=`translateY(${a*ROW_H}px)`;
  $('vwin').innerHTML=html;
}
$('vl').addEventListener('scroll',renderVL);
window.addEventListener('resize',renderVL);
$('vl').addEventListener('click',e=>{
  const row=e.target.closest('.vr');if(!row)return;
  const i=+row.dataset.i,it=S.view[i];
  if(it.t==='s'){
    const ids=[];for(let j=i+1;j<S.view.length&&S.view[j].t==='r';j++)ids.push(S.view[j].r.id);
    const all=ids.every(id=>S.sel.has(id));ids.forEach(id=>all?S.sel.delete(id):S.sel.add(id));
  }else if(e.shiftKey&&S.anchor>=0){
    const a=Math.min(S.anchor,i),b=Math.max(S.anchor,i);
    for(let j=a;j<=b;j++)if(S.view[j].t==='r')S.sel.add(S.view[j].r.id);
  }else{
    const id=it.r.id;S.sel.has(id)?S.sel.delete(id):S.sel.add(id);S.anchor=i;
  }
  renderVL();updateSelbar();
});
$('vl').addEventListener('dragstart',e=>{
  const row=e.target.closest('.vr.r');if(!row)return;
  const r=S.view[+row.dataset.i].r;
  if(!S.sel.has(r.id)){S.sel.clear();S.sel.add(r.id)}
  e.dataTransfer.setData('text/plain','rows');e.dataTransfer.effectAllowed='copy';
  const g=document.createElement('div');g.textContent=`${S.sel.size} строк → договорная`;
  g.style.cssText='position:absolute;top:-100px;padding:6px 10px;background:#1f2f4d;color:#fff;border-radius:4px;font:12px sans-serif';
  document.body.appendChild(g);e.dataTransfer.setDragImage(g,10,10);setTimeout(()=>g.remove(),0);
});
$('vl').addEventListener('dragend',()=>{renderVL();updateSelbar()});
$('q').addEventListener('input',e=>{S.q=e.target.value;refreshView()});
$('flt').addEventListener('change',e=>{S.filter=e.target.value;refreshView()});
$('selFound').addEventListener('click',()=>{S.view.forEach(x=>{if(x.t==='r')S.sel.add(x.r.id)});renderVL();updateSelbar();toast(`Выделено строк: ${fmt(S.sel.size)}`)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&S.sel.size){S.sel.clear();renderVL();updateSelbar()}});

function updateSelbar(){
  const n=S.sel.size;$('selbar').classList.toggle('hidden',!n);$('selN').textContent=fmt(n);
  const tn=idx.get(S.target);
  $('bInto').classList.toggle('hidden',!tn);$('bUn').classList.toggle('hidden',!tn);
  if(tn){const nm=tn.name.length>28?tn.name.slice(0,28)+'…':tn.name;$('bInto').textContent=`→ В «${nm}»`;$('bUn').textContent='Отвязать от выбранной'}
}
$('selbar').addEventListener('click',e=>{
  const a=e.target.closest('[data-a]');if(!a)return;
  const ids=[...S.sel],act=a.dataset.a,tn=idx.get(S.target);
  if(act==='clr'){S.sel.clear()}
  else if(act==='new'){newPos(ids)}
  else if(act==='each'){
    if(ids.length>3000&&!confirm(`Будет создано ${ids.length} позиций. Продолжить?`))return;
    const par=insertParent();let last=null;
    ids.forEach(id=>{const r=S.rows[id];last=addChild(par,mkNode({name:r.name||'(без наименования)',unit:r.unit,qty:r.qty,strict:true}));linkRows(last,[id])});
    toast(`Создано позиций: ${ids.length}`);S.sel.clear();
  }
  else if(act==='intoT'&&tn){const c=linkRows(tn,ids);toast(`Связано ${c} строк → «${tn.name}»`);S.sel.clear()}
  else if(act==='unT'&&tn){unlinkRows(tn,ids);toast('Связи сняты');S.sel.clear()}
  afterChange();
});
function newPos(ids){
  const rows=ids.map(i=>S.rows[i]);
  const secs=new Set(rows.map(r=>r.sec)),units=new Set(rows.map(r=>r.unit));
  let name,unit,qty,strict=false;
  if(rows.length===1){name=rows[0].name;unit=rows[0].unit;qty=rows[0].qty;strict=true}
  else{
    name=(secs.size===1?S.secs[rows[0].sec].name:rows[0].name+' и др.')+` (${rows.length} поз.)`;
    if(units.size===1){unit=rows[0].unit;qty=rows.reduce((s,r)=>s+r.qty,0)}else{unit='компл.';qty=1}
  }
  const n=addChild(insertParent(),mkNode({name,unit,qty,strict}));
  linkRows(n,ids);S.sel.clear();S.target=n.id;afterChange();
  const inp=document.querySelector(`.nd[data-id="${n.id}"] .nm`);
  if(inp){inp.scrollIntoView({block:'center'});inp.focus();inp.select()}
  toast('Позиция создана — переименуйте её при необходимости');
}
function afterChange(){renderTree();updateSelbar();updateStats();refreshView()}

/* ===================== RIGHT: contract tree ===================== */
function nodeHTML(n,d){
  const kids=n.ch.length,open=S.exp.has(n.id),cnt=cntRec(n);
  let h=`<div class="nd ${S.target===n.id?'tg':''} ${n.hidden?'dim':''}" data-id="${n.id}" style="padding-left:${6+d*18}px">
    <button class="chev" data-a="tog">${kids?(open?'▾':'▸'):'·'}</button>
    <span class="ico">${kids||n.kind==='g'?'▤':'▪'}</span>
    <input class="nm" data-f="name" value="${esc(n.name)}" placeholder="Наименование в договоре">`;
  if(!kids)h+=`<input class="un" data-f="unit" value="${esc(n.unit)}"><input class="qt" data-f="qty" type="number" value="${n.qty}">`;
  h+=`<span class="bd ${cnt?'ok':'no'}" title="Связано строк Excel">🔗 ${fmt(cnt)}</span>
    <button class="ib ${(kids?n.hideKids:n.hidden)?'on':''}" data-a="eye" title="${kids?'Не показывать состав группы в договоре':'Не выводить строку в договор (входит в итог группы)'}">${(kids?n.hideKids:n.hidden)?'🚫':'👁'}</button>
    <button class="ib" data-a="addc" title="Добавить вложенную позицию">＋</button>
    <button class="ib dn" data-a="del" title="Удалить">✕</button></div>`;
  if(kids&&open)for(const c of n.ch)h+=nodeHTML(c,d+1);
  return h;
}
function renderTree(){
  const t=$('tree');
  if(!S.roots.length){
    t.innerHTML=`<div class="empty"><h3>Договорная спецификация пуста</h3>
      Соберите её из спецификации продавца слева. Быстрые способы:
      <div class="cards">
        <button class="card" data-r="mirror"><b>Зеркально</b><span>Группа на каждый раздел Excel, 1 строка Excel → 1 позиция. Дальше — склеить и скрыть лишнее.</span></button>
        <button class="card" data-r="sections"><b>Только разделы</b><span>В договоре — только группы, весь состав раздела связан с группой и скрыт.</span></button>
        <button class="card" data-r="hint"><b>Вручную</b><span>Выделите строки слева (поиск → «Выделить все найденные», раздел целиком, Shift-диапазон) и нажмите «Новая позиция» или перетащите на существующую.</span></button>
      </div></div>`;return;
  }
  t.innerHTML=S.roots.map(n=>nodeHTML(n,0)).join('');
}
const tree=$('tree');
function setTarget(id){
  S.target=id;tree.querySelectorAll('.nd').forEach(e=>e.classList.toggle('tg',e.dataset.id===id));
  updateSelbar();if(S.filter==='target')refreshView();
}
tree.addEventListener('click',e=>{
  const r=e.target.closest('[data-r]');if(r){rightAction(r.dataset.r);return}
  const row=e.target.closest('.nd');if(!row)return;
  const n=idx.get(row.dataset.id),a=e.target.closest('[data-a]');
  if(a){
    const act=a.dataset.a;
    if(act==='tog'){S.exp.has(n.id)?S.exp.delete(n.id):S.exp.add(n.id);renderTree()}
    else if(act==='eye'){n.ch.length?n.hideKids=!n.hideKids:n.hidden=!n.hidden;renderTree()}
    else if(act==='addc'){n.kind='g';const c=addChild(n,mkNode({name:'Новая позиция'}));S.target=c.id;renderTree();updateStats();const i=document.querySelector(`.nd[data-id="${c.id}"] .nm`);i&&(i.focus(),i.select())}
    else if(act==='del'){if(cntRec(n)&&!confirm(`Удалить «${n.name}»? Будет снято связей: ${cntRec(n)}`))return;removeNode(n);afterChange()}
    return;
  }
  if(e.target.tagName!=='INPUT')setTarget(n.id);
});
tree.addEventListener('focusin',e=>{const row=e.target.closest('.nd');if(row&&e.target.tagName==='INPUT'&&S.target!==row.dataset.id)setTarget(row.dataset.id)});
tree.addEventListener('input',e=>{
  const row=e.target.closest('.nd'),f=e.target.dataset.f;if(!row||!f)return;
  const n=idx.get(row.dataset.id);n[f]=f==='qty'?Number(e.target.value):e.target.value;
  if(f==='name')updateSelbar();
});
tree.addEventListener('dragover',e=>{const r=e.target.closest('.nd');if(r){e.preventDefault();r.classList.add('dropping')}});
tree.addEventListener('dragleave',e=>{const r=e.target.closest('.nd');r&&r.classList.remove('dropping')});
tree.addEventListener('drop',e=>{
  e.preventDefault();const r=e.target.closest('.nd');if(!r)return;r.classList.remove('dropping');
  const n=idx.get(r.dataset.id),c=linkRows(n,[...S.sel]);toast(`Связано ${c} строк → «${n.name}»`);S.sel.clear();S.target=n.id;afterChange();
});
document.querySelector('#right .ph').addEventListener('click',e=>{const b=e.target.closest('[data-r]');b&&rightAction(b.dataset.r)});
function rightAction(a){
  if(a==='addg'){const g=addChild(insertParent(),mkNode({kind:'g',name:'Новая группа'}));S.target=g.id;renderTree();updateStats();const i=document.querySelector(`.nd[data-id="${g.id}"] .nm`);i&&(i.focus(),i.select())}
  else if(a==='addp'){const p=addChild(insertParent(),mkNode({name:'Новая позиция'}));S.target=p.id;renderTree();updateStats();const i=document.querySelector(`.nd[data-id="${p.id}"] .nm`);i&&(i.focus(),i.select())}
  else if(a==='auto'){if(!S.roots.length){toast('Выберите способ в центре панели');return}
    if(confirm('Перестроить договорную заново? Текущие связи будут сброшены.')){resetAll();afterChange()}}
  else if(a==='mirror'){
    resetAll();
    S.secs.forEach(sec=>{const g=addChild(null,mkNode({kind:'g',name:sec.name}));S.exp.delete(g.id);
      sec.rows.forEach(r=>{const n=addChild(g,mkNode({name:r.name||'(без наименования)',unit:r.unit,qty:r.qty,strict:true}));linkRows(n,[r.id])});S.exp.delete(g.id)});
    afterChange();toast('Создано зеркально: группы по разделам, 1 строка → 1 позиция');
  }
  else if(a==='sections'){
    resetAll();
    S.secs.forEach(sec=>{const g=addChild(null,mkNode({kind:'g',name:sec.name,unit:'компл.',qty:1}));linkRows(g,sec.rows.map(r=>r.id))});
    afterChange();toast('Созданы группы по разделам — состав скрыт внутри групп');
  }
  else if(a==='hint'){toast('Выделяйте строки слева → «Новая позиция из выделенного»')}
}

/* ===================== TAB 2 (ветка «дерево»): заказная вместе с договорной и Excel ===================== */
const LH=32;
const TR={O:null,OM:new Map(),seq:0,mode:'all',cc:new Set(),xo:new Map(),oc:new Set(),sel:new Set(),exSel:new Set(),tgC:null,selO:null,selSrc:new Set(),
  q:'',flt:'all',lines:[],terms:[],byCp:new Map(),kids:new Map(),exMap:new Map(),exFree:[],lineOf:new Map(),exLine:new Map(),num:[],
  flash:new Set(),bm:new Map(),det:false,freeOpen:false,ac:null,anchor:-1,noFocus:false};

/* ---------- единицы измерения, суммы и контроли (сверка только со строками Excel) ---------- */
const UALIAS={'шт':'шт','штука':'шт','штук':'шт','pcs':'шт','м':'м','метр':'м','метров':'м','мп':'м','пм':'м','компл':'компл','комплект':'компл','кт':'компл','уп':'уп','упак':'уп','упаковка':'уп','кг':'кг','килограмм':'кг','л':'л','литр':'л'};
function uNorm(u){const k=String(u||'').toLowerCase().replace(/[\s.]/g,'');return UALIAS[k]||k}
function unitDiff(r,o){const a=uNorm(r.unit),b=uNorm(o.unit);return !!a&&!!b&&a!==b}
function srcRows(o){return o.src.map(id=>S.rows[id])}
function srcSum(o){let s=0;for(const id of o.src)s+=S.rows[id].qty;return s}            /* Σ по ВСЕМ связанным строкам Excel, единицы не учитываются */
function srcDiffRows(o){return srcRows(o).filter(r=>unitDiff(r,o))}
/* количество группы — множитель состава: при проверке количества вложенных строк оно умножается; в самих строках количество — на одну группу */
function mult(o){let m=1;while(o.par){o=TR.OM.get(o.par);if(!o)break;if(o.kind==='g')m*=(+o.qty||0)}return m}
function effQty(o){return Math.round((+o.qty||0)*mult(o)*1e6)/1e6}
/* строки без связи с Excel сверяются по позиции договора: Σ заказных (с множителями групп) ↔ Σ строк Excel позиции (нет строк Excel — количество позиции) */
function blkInfo(cpId){let m=TR.bm.get(cpId);if(m)return m;const n=idx.get(cpId);let ord=0,has=false;
  for(const o of allIn(TR.byCp.get(cpId)||[],[])){if(o.kind==='g')continue;ord+=effQty(o);if(!o.src.length)has=true}
  ord=Math.round(ord*1e6)/1e6;
  const hasEx=!!(n&&n.rows.length),ex=hasEx?n.rows.reduce((a,id)=>a+S.rows[id].qty,0):(n?n.qty:0);
  m={ord,ex,has,hasEx};TR.bm.set(cpId,m);return m}
function blkOf(o){if(o.kind==='g'||o.src.length)return null;const c=cpOf(o);return c?blkInfo(c):null}
function blkBad(o){const b=blkOf(o);return !!b&&Math.abs(b.ord-b.ex)>1e-9}
function qtyBad(o){if(o.kind==='g')return false;return o.src.length>0?Math.abs(effQty(o)-srcSum(o))>1e-9:blkBad(o)}
function unitBad(o){return o.kind!=='g'&&o.src.length>0&&srcDiffRows(o).length>0}
function oSig(o){const b=blkOf(o);return effQty(o)+'|'+srcSum(o)+'|'+(b?b.ord+'/'+b.ex:'')+'|'+srcDiffRows(o).length+'|'+o.unit}
function ackValid(o){return !!o.ack&&o.ack.sig===oSig(o)}
function oRaw(o){return qtyBad(o)||unitBad(o)}
function qOpen(o){return oRaw(o)&&!ackValid(o)}
function qCls(o){return qtyBad(o)?(ackValid(o)?'qack':'qbad'):''}
function gqCls(g){let bad=false,ack=false;for(const x of allIn(kidsOf(g),[])){if(qtyBad(x)){if(ackValid(x))ack=true;else bad=true}}return bad?'qbad':(ack?'qack':'')}
function uCls(o){return unitBad(o)&&!ackValid(o)?'ubad':''}
function qtyTip(o){const t=[];
  if(qtyBad(o)&&!o.src.length){const b=blkOf(o);t.push('Σ заказных по позиции договора (с учётом множителей групп) = '+b.ord+', '+(b.hasEx?'Σ строк Excel позиции':'количество в договоре')+' = '+b.ex+' (Δ '+(b.ord-b.ex>0?'+':'')+Math.round((b.ord-b.ex)*1e6)/1e6+')')}
  else if(qtyBad(o)){const m=mult(o),d=effQty(o)-srcSum(o);t.push('Σ связанных строк Excel = '+srcSum(o)+', в заказной '+(m!==1?o.qty+' × '+m+' (множитель групп) = '+effQty(o):o.qty)+' (Δ '+(d>0?'+':'')+d+')')}
  if(unitBad(o))t.push('Другая ед. изм. у '+srcDiffRows(o).length+' строк Excel');
  if(ackValid(o)&&oRaw(o))t.push('✓ согласовано: '+o.ack.text);
  return t.join(' · ')}
function askAck(label){const t=prompt(label,'');return t&&t.trim()?t.trim():null}

/* ---------- справочник 1С: быстрый поиск ---------- */
function catIdx(){if(catArr._i)return;catArr.forEach(it=>{it._s=(it.art+' '+it.name+' '+it.manuf+' '+it.code).toLowerCase()});catArr._i=1}
function catFind(q,lim){catIdx();q=q.trim().toLowerCase();if(!q)return catArr.slice(0,lim);
  const tk=q.split(/\s+/),a=[],b=[];
  for(const it of catArr){let ok=true;for(const t of tk)if(!it._s.includes(t)){ok=false;break}
    if(!ok)continue;(it.art.toLowerCase().startsWith(tk[0])?a:b).push(it);if(a.length>=lim)break}
  return a.concat(b).slice(0,lim)}

/* ---------- модель: заказные строки (одна глобальная спецификация) ---------- */
function mkO(p){const o=Object.assign({id:'o'+(++OID),kind:'p',par:null,cp:null,code:'',art:'',manuf:'',name:'',unit:'шт.',qty:1,comment:'',src:[],isNew:false,seq:++TR.seq},p);TR.O.push(o);TR.OM.set(o.id,o);return o}
function orderFromRow(r,extra){const it=catalog.get(norm(r.art));
  return it?Object.assign({code:it.code,art:it.art,manuf:it.manuf,name:it.name,unit:it.unit,qty:r.qty,src:[r.id],seq:r.id+1},extra||{})
           :Object.assign({isNew:true,art:r.art.trim(),manuf:r.manuf,name:r.name,unit:r.unit,qty:r.qty,src:[r.id],seq:r.id+1},extra||{})}
function prefill(){
  if(TR.O)return 0;TR.O=[];TR.OM=new Map();TR.seq=0;let c=0;
  for(const r of S.rows){if(!catalog.has(norm(r.art)))continue;mkO(orderFromRow(r));c++}
  TR.seq=S.rows.length+1;return c}
function prefillMore(){let c=0,miss=0;for(const r of S.rows){if(TR.exMap.has(r.id))continue;if(!catalog.has(norm(r.art))){miss++;continue}mkO(orderFromRow(r));c++}return{c,miss}}
function validate(){if(!TR.O)return;for(const o of TR.O){if(o.cp){const n=idx.get(o.cp);if(!n||n.ch.length)o.cp=null}if(o.par&&!TR.OM.has(o.par))o.par=null}}
function topOf(o){while(o.par){const p=TR.OM.get(o.par);if(!p)break;o=p}return o}
function cpOf(o){return topOf(o).cp||null}
function isAnc(a,o){while(o&&o.par){if(o.par===a.id)return true;o=TR.OM.get(o.par)}return false}   /* a — предок o */
function kidsOf(o){return TR.kids.get(o.id)||[]}
function cntKids(o){let c=0;for(const x of kidsOf(o)){c++;c+=cntKids(x)}return c}
function subSome(o,pred){if(pred(o))return true;for(const x of kidsOf(o))if(subSome(x,pred))return true;return false}
function flat(list,d,out){for(const o of list){out.push({o,d});if(o.kind==='g'&&!TR.oc.has(o.id)){const k=TR.kids.get(o.id);if(k)flat(k,d+1,out)}}return out}
function allIn(list,out){for(const o of list){out.push(o);const k=TR.kids.get(o.id);if(k)allIn(k,out)}return out}

function rebuild(){
  const kids=new Map(),by=new Map(),ex=new Map();
  if(TR.O)for(const o of TR.O){
    if(o.par&&TR.OM.has(o.par)){let a=kids.get(o.par);if(!a)kids.set(o.par,a=[]);a.push(o)}
    else{o.par=null;const k=o.cp||'_';let a=by.get(k);if(!a)by.set(k,a=[]);a.push(o)}
    for(const id of o.src){let a=ex.get(id);if(!a)ex.set(id,a=[]);a.push(o)}
  }
  const cmp=(a,b)=>a.seq-b.seq;by.forEach(a=>a.sort(cmp));kids.forEach(a=>a.sort(cmp));
  TR.byCp=by;TR.kids=kids;TR.exMap=ex;
  TR.terms=[];(function w(ns){for(const n of ns){if(n.ch.length)w(n.ch);else TR.terms.push(n)}})(S.roots);
  TR.exFree=[];for(const r of S.rows)if(!r.links.length)TR.exFree.push(r.id);
}
function xOpen(n){const v=TR.xo.get(n.id);return v===undefined?true:v}
/* В режиме «только договорные строки» состав Excel всё равно нужен для разделов
   и вручную созданных позиций. Зеркальные строки (strict) остаются скрытыми. */
function showExcel(n){return TR.mode==='all'||n.kind==='g'||!n.strict}
function inl(n){return TR.mode==='all'&&n.rows.length===1}   /* одна строка Excel в зеркальном режиме показывается в строке позиции */
function hasExcelRows(n){return showExcel(n)&&n.rows.length>0&&!inl(n)}
function gStats(n){let pos=0,ord=0,iss=0;
  (function w(x){if(x.ch.length){for(const c of x.ch)w(c)}else{pos++;const a=TR.byCp.get(x.id);if(a)for(const o of allIn(a,[])){ord++;if(qOpen(o))iss++}}})(n);
  return{pos,ord,iss}}

/* ---------- строки выровненного представления ---------- */
function buildLines(){
  TR.bm=new Map();
  const L=[],q=TR.q.trim().toLowerCase(),filtering=!!q||TR.flt!=='all';
  TR.lineOf=new Map();TR.exLine=new Map();TR.num=[];
  let num=0,cnt=[];
  const lab=d=>{if(d===0){cnt=[++num];return String(num)}cnt.length=Math.min(cnt.length,d+1);cnt[d]=(cnt[d]||0)+1;cnt.length=d+1;return cnt.join('.')};
  const omatch=o=>!q||(o.art+' '+o.name+' '+o.manuf+' '+o.code).toLowerCase().includes(q);
  function push(l,r,n){const i=L.length;L.push({l,r,n});
    if(r&&r.t==='o'){TR.lineOf.set(r.o.id,i);if(r.d===0)TR.num[parseInt(r.num,10)]=r.o.id}
    if(l&&l.t==='ex'&&!TR.exLine.has(l.id))TR.exLine.set(l.id,i);if(l&&l.t==='cp'&&l.inl)TR.exLine.set(l.n.rows[0],i)}
  function block(n,d){
    if(TR.flt==='nolink')return;
    const ords=TR.byCp.get(n.id)||[],R=flat(ords,0,[]),RA=allIn(ords,[]);
    let iss=0,nw=0;for(const o of RA){if(qOpen(o))iss++;if(o.isNew)nw++}
    let used=0;for(const id of n.rows)if(TR.exMap.has(id))used++;
    if(TR.flt==='issues'&&!iss)return;
    if(TR.flt==='new'&&!nw)return;
    if(TR.flt==='rest'&&!(n.rows.length&&used<n.rows.length))return;
    if(TR.flt==='empty'&&R.length)return;
    if(q){let ok=n.name.toLowerCase().includes(q)||RA.some(omatch);
      if(!ok&&showExcel(n))for(const id of n.rows){if(S.rows[id].s.includes(q)){ok=true;break}}
      if(!ok)return}
    /* позиция договора напротив 1-й заказной; остальные заказные — напротив пустых строк; строки Excel — ниже */
    const Ls=[{t:'cp',n,d,iss,cnt:RA.filter(x=>x.kind!=='g').length,used,tot:n.rows.length,inl:inl(n)}];
    for(let i=1;i<R.length;i++)Ls.push({t:'lpad',n});
    if(hasExcelRows(n)&&xOpen(n))for(const id of n.rows)Ls.push({t:'ex',id,d:d+1});
    const H=Math.max(Ls.length,R.length,1);
    for(let i=0;i<H;i++){
      let r=null;if(i<R.length)r={t:'o',o:R[i].o,d:R[i].d,num:lab(R[i].d)};else if(i===0)r={t:'empty',n};
      push(Ls[i]||{t:'lpad2'},r,n);
    }
  }
  function walk(ns,d){for(const n of ns){
    if(n.ch.length){const col=TR.cc.has(n.id)&&!filtering,st=L.length;push({t:'cg',n,d,col},{t:'rcg',n,d,col},n);if(!col)walk(n.ch,d+1);if(!col&&L.length===st+1)L.pop()}
    else block(n,d)}}
  walk(S.roots,0);
  /* заказные без договорной позиции — «куча» в конце */
  if(TR.flt==='all'||TR.flt==='issues'||TR.flt==='new'||TR.flt==='nolink'){
    const P=TR.byCp.get('_')||[];
    let list=P;
    if(q||TR.flt==='issues'||TR.flt==='new')list=P.filter(o=>subSome(o,x=>omatch(x)&&(TR.flt!=='issues'||qOpen(x))&&(TR.flt!=='new'||x.isNew)));
    let free=TR.exFree;if(q)free=free.filter(id=>S.rows[id].s.includes(q));
    if(list.length||P.length||free.length){
      push({t:'lfree',n:TR.exFree.length},{t:'ub',n:P.length,shown:list.length},null);
      const R=flat(list,0,[]),Lx=(TR.mode==='all'&&TR.freeOpen)?free.map(id=>({t:'ex',id,d:0})):[];
      const H=Math.max(R.length,Lx.length);
      for(let i=0;i<H;i++)push(Lx[i]||{t:'lpad2'},i<R.length?{t:'o',o:R[i].o,d:R[i].d,num:lab(R[i].d)}:null,null);
    }
  }
  TR.lines=L;
}

/* ---------- отрисовка ---------- */
function ix(r,o){return {ru:unitDiff(r,o),bad:oRaw(o),open:qOpen(o)}}
function relCp(id){const o=TR.selO&&TR.OM.get(TR.selO);return !!o&&cpOf(o)===id}
function rightHTML_cg(r){const n=r.n,s=gStatsC(n);
  return `<div class="rc rcg" data-cmd="cg" data-c="${n.id}" style="padding-left:${10+r.d*16}px"><button class="chev">${r.col?'▸':'▾'}</button><span class="nm">${esc(n.name)}</span><span class="lm">заказных ${s.ord}${s.iss?' · ⚠ '+s.iss:''}</span></div>`}
const _gs=new Map();function gStatsC(n){return gStats(n)}
function leftHTML(l,memo){
  if(!l)return '<div class="lc lpad2"></div>';
  if(l.t==='cg'){const n=l.n;let s=memo.get(n.id);if(!s){s=gStats(n);memo.set(n.id,s)}
    return `<div class="lc lg" data-cmd="cg" data-c="${n.id}" style="padding-left:${6+l.d*16}px"><button class="chev">${l.col?'▸':'▾'}</button><span class="tgc" title="Договорная часть">д</span><span class="nm">${esc(n.name)}</span><span class="lm">${s.pos} поз. · заказных ${s.ord}${s.iss?' · ⚠ '+s.iss:''}</span></div>`}
  if(l.t==='cp'){const n=l.n;
    const multi=hasExcelRows(n);
    const chev=multi?`<button class="chev" data-cmd="xp" data-c="${n.id}" title="Строки Excel этой позиции (${n.rows.length})">${xOpen(n)?'▾':'▸'}</button>`:'<span class="chev0"></span>';
    const badge=l.cnt?`<span class="chip ok" title="Заказных строк в позиции">🔗 ${l.cnt}</span><button class="ib mkp" data-cmd="mkpos" data-c="${n.id}" title="Добавить заказную строку в позицию (из необработанных строк Excel или из самой позиции)">＋</button>`:`<button class="chip no mk" data-cmd="mkpos" data-c="${n.id}" title="Создать заказную строку из этой позиции договора (и её строк Excel)">＋ заказная</button>`;
    const iss=l.iss?`<button class="chip warn" data-cmd="ackb" data-c="${n.id}" title="Открытых расхождений с Excel: ${l.iss}. Клик — согласовать все в этой позиции">⚠ ${l.iss}</button>`:'';
    const nm=`<span class="tgc" title="Позиция договорной спецификации">д</span><span class="nm" title="${esc(n.name)}">${esc(n.name)}</span>`+(multi&&l.tot?`<span class="lm2"> · Excel ${l.used}/${l.tot}</span>`:'');
    let head;
    if(l.inl){const r=S.rows[n.rows[0]],inCat=catalog.has(norm(r.art)),os=TR.exMap.get(r.id),o=os&&os[0];
      const cls=o&&qOpen(o)?(unitDiff(r,o)?'ud':(qtyBad(o)?'qd':'')):'';
      head=`<span class="lxi ${TR.selSrc.has(r.id)?'lk':''} ${TR.exSel.has(r.id)?'xs':''} ${cls} ${o?'':'free'}" data-x="${r.id}" title="Строка Excel №${r.n}: ${esc(r.name)} · ${esc(r.unit)} · ${r.qty}${inCat?'':' — артикула нет в 1С'}${o?'':' — не использована в заказной'}. Клик — выбрать для привязки"><span class="mono ${inCat?'':'nocat'}">${r.art?esc(r.art):'нет'}</span></span><span style="display:flex;align-items:center;gap:4px;min-width:0">${nm}</span>`}
    else head=`<span style="grid-column:1/3;display:flex;align-items:center;gap:4px;padding-left:${6+l.d*16}px">${chev}${nm}</span>`;
    return `<div class="lc lp ${TR.tgC===n.id?'tg':''} ${relCp(n.id)?'rel':''}" data-c="${n.id}">${head}<span>${esc(n.unit)}</span><span class="mono" style="text-align:right">${n.qty}</span><span class="lb">${badge}${iss}</span></div>`}
  if(l.t==='lpad')return `<div class="lc lpad ${TR.tgC===l.n.id?'tg':''} ${relCp(l.n.id)?'rel':''}" data-c="${l.n.id}"></div>`;
  if(l.t==='lpad2')return '<div class="lc lpad2"></div>';
  if(l.t==='lfree')return `<div class="lc lfree" data-cmd="free"><button class="chev">${TR.freeOpen&&TR.mode==='all'?'▾':'▸'}</button><span class="nm">Строки Excel без договорной позиции</span><span class="lm">${fmt(l.n)}</span></div>`;
  if(l.t==='ex'){const r=S.rows[l.id],os=TR.exMap.get(l.id),o=os&&os[0],inCat=catalog.has(norm(r.art));
    let cls='',lab='осталась',tip='Не использована в заказной',ru=false;
    if(o){const x=ix(r,o);ru=x.ru;cls=x.open?(x.ru?'ud':(qtyBad(o)?'qd':'')):(x.bad?'ak':'');
      lab=`${cls==='ud'?'⚠ ед.':cls==='qd'?'≠':cls==='ak'?'✓*':'✓'} → ${o.isNew?'НОВАЯ':(o.code||'?')} ${esc(o.art)}`;
      tip=(cls==='ud'?'Ед. изм. строки Excel «'+r.unit+'» ≠ заказной «'+o.unit+'». ':'')+(cls==='qd'?'Количество в заказной ('+o.qty+') ≠ Σ строк Excel ('+srcSum(o)+'). ':'')+'Заказная: '+(o.isNew?'НОВАЯ':o.code)+' · '+o.art+' · '+o.name}
    return `<div class="lc lx ${TR.selSrc.has(r.id)?'lk':''} ${TR.exSel.has(r.id)?'xs':''} ${cls}" data-x="${r.id}"><span class="mono ${inCat?'':'nocat'}" style="padding-left:${6+l.d*16}px" title="${inCat?'':'Такого артикула нет в справочнике 1С'}">${r.art?esc(r.art):'<span class="dirty">нет</span>'}</span><span title="${esc(r.name)}">${esc(r.name)}</span><span class="mono ${ru?'uwarn':''}">${esc(r.unit)}</span><span class="mono" style="text-align:right">${r.qty}</span><span><button class="chip ${o&&!cls.match(/qd|ud/)?'ok':'warn'}" ${o?`data-cmd="jump" data-o="${o.id}"`:`data-cmd="mkx1" data-x="${r.id}"`} title="${o?esc(tip):'Создать заказную строку из этой строки Excel'}">${o?lab:'＋ заказная'}</button></span></div>`}
  return '<div class="lc lpad2"></div>';
}
function rightHTML(r){
  if(!r)return '<div class="rc"></div>';
  if(r.t==='rcg')return rightHTML_cg(r);
  if(r.t==='empty')return `<div class="rc rempty"><span>Нет заказных строк — выделите строки в списке «без договора» и свяжите с этой позицией</span><button class="btn sm" data-cmd="addnew" data-c="${r.n.id}">＋ Новая позиция</button></div>`;
  if(r.t==='ub')return `<div class="rc rub"><span>Заказные строки без договорной позиции</span><span style="font-weight:400">${fmt(r.shown)} из ${fmt(r.n)}</span><button class="btn sm" data-cmd="selpile">Выделить все показанные</button></div>`;
  const o=r.o,g=o.kind==='g',col=TR.oc.has(o.id),sel=TR.sel.has(o.id),d=r.d;
  const code=o.isNew?'<span class="tagnew" title="Нужно создать в 1С">НОВАЯ</span>':`<input class="mono" data-f="code" value="${esc(o.code)}">`;
  const nk=g?cntKids(o):0;
  return `<div class="rr ${g?'rg':''} ${o.isNew?'new':''} ${TR.tgC&&cpOf(o)===TR.tgC?'tgo':''} ${sel?'sel':''} ${TR.selO===o.id?'osel':''} ${TR.flash.has(o.id)?'flash':''}" data-o="${o.id}">
    <span class="rk"><input type="checkbox" data-f="" ${sel?'checked':''} tabindex="-1"></span>
    <span class="rn" draggable="true" style="padding-left:${d*14}px" title="Клик — выделить (Shift — диапазон). Потяните на позицию договора слева, чтобы связать${g?' или на группу, чтобы вложить':''}">${g?`<button class="chev" data-cmd="og">${col?'▸':'▾'}</button>`:''}${esc(r.num)}${o.src.length?`<sup title="Связано строк Excel: ${o.src.length}">${o.src.length}</sup>`:''}</span>
    <span>${code}</span>
    <input class="mono" data-f="art" value="${esc(o.art)}" autocomplete="off"><input data-f="manuf" value="${esc(o.manuf)}">
    <input data-f="name" value="${esc(o.name)}" autocomplete="off" ${nk?`title="В группе вложено: ${nk}"`:''}>
    <input data-f="unit" class="${uCls(o)}" value="${esc(o.unit)}"><input data-f="qty" type="number" class="${g?gqCls(o):qCls(o)}" value="${o.qty}" style="text-align:right" title="${g?'Множитель состава группы: при проверке количество каждой вложенной строки умножается на это число. В самих строках — количество на одну группу.':esc(qtyTip(o))}">
    <input data-f="comment" value="${esc(o.comment||'')}">
    <span class="ract">${g?`<button class="ib" data-cmd="addc" title="Добавить новую позицию в группу">＋</button>`:''}${g&&TR.sel.size&&!TR.sel.has(o.id)?`<button class="ib on" data-cmd="into" title="Перенести выделенные в эту группу">⇥</button>`:''}${d>0?`<button class="ib" data-cmd="out" title="Вынести из группы">⇱</button>`:''}<button class="ib" data-cmd="grp" title="${g?'Разгруппировать (вложенные выйдут из группы)':'Сделать группой'}">${g?'⊟':'▤'}</button><button class="ib dn" data-cmd="del" title="Удалить">✕</button></span>
  </div>`}
function draw(){
  TR.bm=new Map();
  const vl=$('tv'),st=vl.scrollTop,h=vl.clientHeight||600;
  const a=Math.max(0,Math.floor(st/LH)-6),b=Math.min(TR.lines.length,Math.ceil((st+h)/LH)+6),memo=new Map();
  const ae=document.activeElement;let rf=null;
  if(ae&&ae.dataset&&ae.dataset.f&&ae.closest&&ae.closest('#twin')){const row=ae.closest('.rr');if(row)rf={o:row.dataset.o,f:ae.dataset.f,s:ae.selectionStart,e:ae.selectionEnd}}
  let s='';for(let i=a;i<b;i++){const ln=TR.lines[i];s+=`<div class="tl" data-i="${i}">${leftHTML(ln.l,memo)}${rightHTML(ln.r)}</div>`}
  const w=$('twin');w.style.transform=`translateY(${a*LH}px)`;w.innerHTML=s;
  if(rf){const el=w.querySelector(`.rr[data-o="${rf.o}"] [data-f="${rf.f}"]`);if(el){TR.noFocus=true;try{el.focus({preventScroll:true});if(rf.s!=null)el.setSelectionRange(rf.s,rf.e)}catch(_){}TR.noFocus=false;if(TR.ac){TR.ac.inp=el;if(!document.activeElement||document.activeElement!==el)acHide();else acShow(el)}}else if(TR.ac)acHide()}else if(TR.ac&&!(ae&&ae===TR.ac.inp))acHide()
}
function relines(){buildLines();$('tsp').style.height=(TR.lines.length*LH+26)+'px';draw()}
function relayout(){rebuild();relines();tStat();updateInfo();updateBar()}
function tStat(){
  if(!TR.O)return;let linked=0,iss=0,nw=0,tot=TR.O.length;
  for(const o of TR.O){if(cpOf(o))linked++;if(qOpen(o))iss++;if(o.isNew)nw++}
  $('stat').textContent=`Заказная: ${fmt(tot)} строк · связано с договором ${fmt(linked)} · без связи ${fmt(tot-linked)}${nw?' · новых для 1С '+fmt(nw):''}`;
  $('statBar').style.width=(tot?linked/tot*100:0)+'%';
  $('tIss').textContent=iss?'Расхождений с Excel: '+fmt(iss):'Расхождений с Excel нет';
  $('tmeta').textContent=`${fmt(S.rows.length)} строк Excel · ${fmt(TR.terms.length)} позиций договора`;
}
function scrollToLine(i){const vl=$('tv');vl.scrollTop=Math.max(0,i*LH-(vl.clientHeight||600)/3);draw()}
function expandAncestors(nodeId){let n=idx.get(nodeId);while(n){TR.cc.delete(n.id);n=n.p?idx.get(n.p):null}}
function scrollToOrder(id){
  let o=TR.OM.get(id);if(!o)return;
  let p=o;while(p.par){p=TR.OM.get(p.par);if(!p)break;TR.oc.delete(p.id)}
  const cp=cpOf(o);if(cp)expandAncestors(cp);
  buildLines();$('tsp').style.height=(TR.lines.length*LH+26)+'px';
  const i=TR.lineOf.get(id);if(i!==undefined)scrollToLine(i);else draw()}
function jumpToExcel(id){
  const r=S.rows[id];let n=null;for(const lid of r.links){const x=idx.get(lid);if(x&&!x.ch.length){n=x;break}}
  if(TR.mode!=='all'){TR.mode='all';$('tMode').value='all'}
  if(n){TR.xo.set(n.id,true);expandAncestors(n.id)}else TR.freeOpen=true;
  buildLines();$('tsp').style.height=(TR.lines.length*LH+26)+'px';
  const i=TR.exLine.get(id);if(i!==undefined)scrollToLine(i);else toast('Эта строка Excel скрыта текущим фильтром или поиском')}

/* ---------- выбор / подсветка ---------- */
function setSel(id){TR.selO=id;const o=id&&TR.OM.get(id);TR.selSrc=new Set(o?o.src:[])}
function paintSel(){draw();return;document.querySelectorAll('#twin .rr').forEach(e=>e.classList.toggle('osel',e.dataset.o===TR.selO));document.querySelectorAll('#twin .lx').forEach(e=>e.classList.toggle('lk',TR.selSrc.has(+e.dataset.x)))}
function selToggle(oid,shift){
  const i=TR.lineOf.get(oid);
  if(shift&&TR.anchor>=0&&i!==undefined){const a=Math.min(TR.anchor,i),b=Math.max(TR.anchor,i);for(let j=a;j<=b;j++){const r=TR.lines[j].r;if(r&&r.t==='o')TR.sel.add(r.o.id)}}
  else{TR.sel.has(oid)?TR.sel.delete(oid):TR.sel.add(oid);TR.anchor=i===undefined?-1:i}
  draw();updateBar()}
function selTop(){const out=[];
  for(const id of TR.sel){const o=TR.OM.get(id);if(!o)continue;let a=o,skip=false;while(a.par){a=TR.OM.get(a.par);if(!a)break;if(TR.sel.has(a.id)){skip=true;break}}if(!skip)out.push(o)}
  out.sort((x,y)=>(TR.lineOf.has(x.id)?TR.lineOf.get(x.id):1e9)-(TR.lineOf.has(y.id)?TR.lineOf.get(y.id):1e9));return out}

/* ---------- информация о выбранной заказной строке + связанные строки Excel ---------- */
function updateCinfo(){
  const b=$('cinfo'),n=TR.tgC&&idx.get(TR.tgC);
  if(!n||n.ch.length){b.classList.add('hidden');return false}
  const A=blockOrders(n.id).filter(o=>o.kind!=='g'),nw=A.filter(o=>o.isNew).length,qb=A.filter(qOpen).length,qa=A.filter(o=>oRaw(o)&&ackValid(o)).length;
  const rest=n.rows.filter(id=>!(TR.exMap.get(id)||[]).length).length,xs=n.rows.reduce((a,id)=>a+S.rows[id].qty,0);
  b.classList.remove('hidden');
  b.innerHTML=`<span>Позиция договора: <b>${esc(n.name)}</b> (${esc(n.unit)}, ${n.qty}) · заказных строк: <b>${A.length}</b> (количество и ед. изм. сверяются только со связанными строками Excel)`+
    `${nw?` · новых (нет в 1С): <b>${nw}</b>`:''}${n.rows.length?(rest?` · <b style="color:#b35f00">не обработано строк Excel: ${rest}</b>`:' · все строки Excel обработаны'):' · строк Excel нет'}${(()=>{const bi=blkInfo(n.id);return ` · Σ заказных = <b>${bi.ord}</b> · ${bi.hasEx?'Σ Excel':'в договоре'} = <b>${bi.ex}</b>`})()}`+
    `${qb?` · <b style="color:var(--danger)">расхождение с Excel (кол-во/ед. изм.): ${qb} зак. строк</b>`:''}${qa?` · согласовано расхождений: ${qa}`:''}</span><span>`+
    `<button class="btn sm pr" data-cmd="mkpos" data-c="${n.id}" title="Создать заказную строку из этой позиции: из необработанных строк Excel, а если их нет — из самой позиции договора">＋ Заказная из позиции</button> ${qb?`<button class="btn sm" data-cmd="ackb" data-c="${n.id}">Согласовать расхождения позиции (${qb})…</button> `:''}${n.rows.length?`<button class="btn sm" data-cmd="cdet">${TR.cdet?'Скрыть':'Показать'} строки Excel (${n.rows.length})</button> `:''}<button class="btn sm" data-cmd="tgclr">Снять выбор позиции</button></span>`;
  return true}
function updateInfo(){
  const hasC=updateCinfo();
  const b=$('oinfo'),dv=$('odet'),o=TR.selO&&TR.OM.get(TR.selO);
  if(!o&&hasC&&TR.cdet){const n=idx.get(TR.tgC);dv.classList.remove('hidden');
    dv.innerHTML=n.rows.slice(0,200).map(id=>{const r=S.rows[id],os=TR.exMap.get(id),x=os&&os[0];let cls='',lab='осталась',ru=false;
      if(x){ru=unitDiff(r,x);cls=qOpen(x)?(ru?'⚠ ед.':(qtyBad(x)?'≠':'')):(oRaw(x)?'✓*':'✓');lab=`${cls||'✓'} → ${x.isNew?'НОВАЯ':(x.code||'?')} ${esc(x.art)}`}
      return `<div class="dsrc"><span class="mono">${r.art?esc(r.art):'нет'}</span><span title="${esc(r.name)}">${esc(r.name)}</span><span class="mono" style="text-align:right">${r.qty}</span><span class="${ru?'uwarn':''}">${esc(r.unit)}</span><span>${lab}</span><span>${x?`<button class="ib" data-cmd="jump" data-o="${x.id}" title="Перейти к заказной строке">🔎</button>`:`<button class="ib" data-cmd="dxsel" data-x="${id}" title="Выбрать для привязки">☐</button>`}</span></div>`}).join('')}
  else if(!o)dv.classList.add('hidden');
  if(!o){b.classList.add('hidden');return}
  const cnt=o.kind==='g'?0:o.src.length,sum=srcSum(o),m=mult(o),d=effQty(o)-sum,df=srcDiffRows(o),ak=ackValid(o)&&oRaw(o),cn=cpOf(o),node=cn&&idx.get(cn);
  let st='';
  if(cnt){st+=d?` · <b style="color:var(--danger)">расхождение ${d>0?'+':''}${d}</b>`:' · количество совпадает';
    if(df.length){const m={};df.forEach(r=>m[r.unit]=(m[r.unit]||0)+r.qty);st+=` · <b style="color:#b35f00">⚠ ${df.length} стр. Excel в другой ед. изм.: ${Object.keys(m).map(u=>m[u]+' '+esc(u)).join(', ')} (входят в Σ)</b>`}
    if(ak)st+=` · <span class="ackok">✓ согласовано: ${esc(o.ack.text)}</span>`}
  else if(o.kind!=='g'){const b=blkOf(o);
    if(b){st=b.ord!==b.ex?` · <b style="color:var(--danger)">Σ заказных по позиции (с учётом групп) = ${b.ord}, ${b.hasEx?'Σ Excel позиции':'в договоре'} = ${b.ex}: расхождение ${Math.round((b.ord-b.ex)*1e6)/1e6>0?'+':''}${Math.round((b.ord-b.ex)*1e6)/1e6}</b>`:` · <i>связанных строк Excel нет — сверка по позиции договора: совпадает (Σ ${b.ord})</i>`;if(ak)st+=` · <span class="ackok">✓ согласовано: ${esc(o.ack.text)}</span>`}
    else st=' · <i>связанных строк Excel нет и нет позиции договора — сверка не выполняется</i>'}
  else st=' · <i>группа: количество — множитель состава</i>';
  b.classList.remove('hidden');
  b.innerHTML=`<span>${o.kind==='g'?'Группа':'Заказная'}: <b>${esc(o.name)}</b> (${esc(o.unit)}) · позиция договора: <b>${node?esc(node.name):'не связана'}</b> · строк Excel: <b>${cnt}</b> · Σ Excel = <b>${sum}</b> · в заказной <b>${m!==1?o.qty+' × '+m+' (групп) = '+effQty(o):o.qty}</b>${st}</span><span>`+
    `${cnt&&d&&m?`<button class="btn sm" data-cmd="fix">Выровнять по Excel (${Math.round(sum/m*1e4)/1e4}${m!==1?' × '+m:''})</button> `:''}${qOpen(o)?'<button class="btn sm" data-cmd="ack">Согласовать расхождение…</button> ':''}${ak?'<button class="btn sm" data-cmd="ackclr">Снять согласование</button> ':''}${cnt?`<button class="btn sm" data-cmd="det">${TR.det?'Скрыть':'Показать'} строки Excel (${cnt})</button> `:''}<button class="btn sm" data-cmd="selclr">Снять выбор</button></span>`;
  if(TR.det&&cnt){dv.classList.remove('hidden');
    dv.innerHTML=o.src.slice(0,200).map(id=>{const r=S.rows[id],ru=unitDiff(r,o);let nm='вне договора';for(const lid of r.links){const x=idx.get(lid);if(x){nm='в позиции: '+x.name;break}}
      return `<div class="dsrc"><span class="mono">${r.art?esc(r.art):'нет'}</span><span title="${esc(r.name)}">${esc(r.name)}</span><span class="mono" style="text-align:right">${r.qty}</span><span class="${ru?'uwarn':''}">${esc(r.unit)}</span><span>${esc(nm)}</span><span><button class="ib" data-cmd="dtfind" data-x="${id}" title="Найти в дереве слева">🔎</button><button class="ib dn" data-cmd="dtdel" data-x="${id}" title="Отвязать от заказной">✕</button></span></div>`}).join('')+(cnt>200?`<div class="hint">Показаны первые 200 из ${cnt}</div>`:'')}
  else dv.classList.add('hidden');
}

/* ---------- панель действий ---------- */
function updateBar(){
  const b=$('tbar'),ns=TR.sel.size,nx=TR.exSel.size;
  if(!ns&&!nx){b.classList.add('hidden');return}
  const tg=TR.tgC&&idx.get(TR.tgC),nm=tg?(tg.name.length>26?tg.name.slice(0,26)+'…':tg.name):'';
  let h='';
  if(ns){h+=`<span><b>${fmt(ns)}</b> заказных выделено</span>`+(tg?`<button class="btn pr" data-cmd="link">→ Связать с «${esc(nm)}»</button><button class="btn" data-cmd="linkseq">⇣ По одной, начиная с неё</button>`:'<span style="opacity:.8">кликните слева позицию договора</span>')+
    `<button class="btn" data-cmd="unlink">Отвязать от договора</button><button class="btn" data-cmd="mkgrp">▤ Сгруппировать</button><button class="btn gh" data-cmd="selnone">✕</button>`}
  if(nx){h+=(ns?'<span style="opacity:.6">|</span>':'')+`<span><b>${fmt(nx)}</b> строк Excel</span>`+(TR.selO?'<button class="btn pr" data-cmd="attach">← Привязать к выбранной заказной</button>':'<span style="opacity:.8">выберите заказную строку справа</span>')+'<button class="btn" data-cmd="mkx">＋ Создать заказные из строк Excel</button><button class="btn gh" data-cmd="xnone">✕</button>'}
  b.innerHTML=h;b.classList.remove('hidden')}

/* ---------- операции: связь с договором, группы ---------- */
function afterMove(list,msg){
  TR.flash=new Set(list.map(o=>o.id));TR.sel.clear();relayout();
  if(list[0])scrollToOrder(list[0].id);
  setTimeout(()=>{TR.flash=new Set();draw()},2300);if(msg)toast(msg)}
function linkTo(list,cpId){for(const o of list){o.par=null;o.cp=cpId;o.auto=false;o.noauto=false}}
function doLink(){const n=idx.get(TR.tgC);if(!n||n.ch.length){toast('Выберите слева позицию договора');return}
  const L=selTop();if(!L.length)return;linkTo(L,n.id);afterMove(L,`Связано с «${n.name}»: ${L.length} — строки переехали к позиции`)}
function doLinkSeq(){const L=selTop();if(!L.length)return;const st=TR.terms.findIndex(n=>n.id===TR.tgC);if(st<0){toast('Выберите слева позицию договора');return}
  let c=0;for(let i=0;i<L.length&&st+i<TR.terms.length;i++){linkTo([L[i]],TR.terms[st+i].id);c++}
  afterMove(L.slice(0,c),`По одной, начиная с «${TR.terms[st].name}»: ${c}`+(c<L.length?` (не хватило позиций договора: ${L.length-c} осталось без связи)`:''))}
function doUnlink(){const L=selTop();for(const o of L){o.cp=null;o.auto=false;o.noauto=true}afterMove(L,'Отвязано от договора: '+L.length)}
function makeGroup(o){o.kind='g';if(o.src.length)o.qty=1;TR.oc.delete(o.id);relayout();toast('Строка стала группой: её количество — множитель состава (сейчас ×'+o.qty+'). Добавьте вложенные позиции кнопкой ＋; группа связана с позицией договора вместе со всем содержимым')}
function ungroup(g){const k=kidsOf(g).slice();for(const x of k){x.par=g.par||null;x.cp=g.par?null:g.cp}g.kind='p';relayout();toast(k.length?'Группа разгруппирована: вложенные позиции остались в той же позиции договора':'Строка больше не группа')}
function addKid(g){const k=kidsOf(g);const o=mkO({par:g.id,isNew:true,name:'Новая позиция',seq:k.length?k[k.length-1].seq+1:++TR.seq});TR.oc.delete(g.id);relayout();focusRow(o.id,'art')}
function addBlank(cpId){const o=mkO({cp:cpId||null,isNew:true,name:'Новая позиция'});relayout();focusRow(o.id,'art')}
function focusRow(id,f){scrollToOrder(id);const el=document.querySelector(`#twin .rr[data-o="${id}"] [data-f="${f}"]`);if(el){el.focus();el.select&&el.select()}}
function moveInto(g){const L=selTop().filter(o=>o!==g&&!isAnc(o,g));if(!L.length){toast('Нечего переносить в группу');return}
  for(const o of L){o.par=g.id;o.cp=null}TR.oc.delete(g.id);afterMove(L,`Вложено в группу: ${L.length} — связаны с той же позицией договора`)}
function takeOut(o){const p=TR.OM.get(o.par);if(!p)return;o.par=p.par||null;o.cp=o.par?null:p.cp;relayout()}
function delOrder(o){const sub=allIn([o],[]);if(sub.length>1&&!confirm(`Удалить группу вместе с вложенными (${sub.length})?`))return;
  const ids=new Set(sub.map(x=>x.id));TR.O=TR.O.filter(x=>!ids.has(x.id));ids.forEach(id=>{TR.OM.delete(id);TR.sel.delete(id)});if(ids.has(TR.selO))setSel(null);relayout()}
function mkGroupFromSel(){const L=selTop();if(!L.length)return;
  const cps=new Set(L.map(o=>o.cp||'_')),first=L[0],cp=TR.tgC&&idx.get(TR.tgC)&&!idx.get(TR.tgC).ch.length?TR.tgC:(first.par?null:first.cp);
  const par=first.par||null;
  const g=mkO({kind:'g',name:'Новая группа',unit:'компл.',qty:1,cp:par?null:cp,par,seq:first.seq});
  for(const o of L){o.par=g.id;o.cp=null}
  afterMove([g],`Создана группа из ${L.length} строк`+(cps.size>1?' (строки были в разных позициях — группа связана с '+(cp?'выбранной':'первой')+')':''));
  focusRow(g.id,'name')}
/* автосвязь: заказная ↔ строки Excel по артикулу+производителю, затем заказная → позиция договора по тому, где лежат её строки Excel */
function autoLink(silent){
  rebuild();const by=new Map();
  for(const r of S.rows){if(!r.art)continue;const k=norm(r.art)+'|'+norm(r.manuf);let a=by.get(k);if(!a)by.set(k,a=[]);a.push(r.id)}
  let nc=0,ns=0;
  for(const o of TR.O){
    if(o.par||o.noauto||o.kind==='g')continue;
    if(o.cp&&!o.auto)continue;
    if(!o.src.length&&o.art){
      const c=(by.get(norm(o.art)+'|'+norm(o.manuf))||[]).filter(id=>!(TR.exMap.get(id)||[]).length);
      if(c.length){o.src=c.slice();c.forEach(id=>TR.exMap.set(id,[o]));ns++}}
    let cp=null;
    for(const id of o.src){for(const lid of S.rows[id].links){const n=idx.get(lid);if(n&&!n.ch.length){cp=n.id;break}}if(cp)break}
    if(cp&&cp!==o.cp){o.cp=cp;o.auto=true;nc++}
  }
  if(!silent){relayout();toast(nc||ns?`Автосвязь по артикулу и производителю: к договору ${fmt(nc)}${ns?', к строкам Excel '+fmt(ns):''}`:'Нечего связывать: у строк Excel нет договорной позиции (проверьте вкладку ①)')}
  return nc}
function ackBulk(list,label){const l=list.filter(qOpen);if(!l.length){toast('Открытых расхождений нет');return}
  const t=askAck(label+' — открытых расхождений: '+l.length+'.\nОбщая причина согласования (например: запас, остаток допоставят позже):');if(!t)return;
  l.forEach(o=>{o.ack={text:t,sig:oSig(o)}});relayout();toast('Согласовано расхождений: '+l.length)}
function blockOrders(nodeId){return allIn(TR.byCp.get(nodeId)||[],[])}
function attachExcel(){const o=TR.selO&&TR.OM.get(TR.selO);if(!o)return;let c=0;
  for(const id of TR.exSel){for(const x of (TR.exMap.get(id)||[]))if(x!==o)x.src=x.src.filter(i=>i!==id);if(!o.src.includes(id)){o.src.push(id);c++}}
  TR.exSel.clear();setSel(o.id);relayout();toast('Привязано строк Excel к заказной: '+c)}
function exNode(r){for(const lid of r.links){const n=idx.get(lid);if(n&&!n.ch.length)return n.id}return null}
function mkPos(cpId){const n=idx.get(cpId);if(!n||n.ch.length)return;
  const un=n.rows.filter(id=>!(TR.exMap.get(id)||[]).length),made=[];
  if(un.length)for(const id of un)made.push(mkO(orderFromRow(S.rows[id],{cp:cpId})));
  else made.push(mkO({cp:cpId,isNew:true,name:n.name,unit:n.unit,qty:n.qty,seq:++TR.seq}));
  TR.tgC=cpId;afterMove(made,un.length?`Создано заказных из строк Excel позиции: ${made.length}`:'Создана заказная строка из позиции договора (новая, нет в 1С) — выберите номенклатуру в «Артикул» / «Наименование»')}
function mkEx1(id){const r=S.rows[id],o=mkO(orderFromRow(r,{cp:exNode(r)}));afterMove([o],'Создана заказная из строки Excel')}
function makeFromExcel(){let c=0,first=null;
  for(const id of TR.exSel){const r=S.rows[id];let cp=TR.tgC&&idx.get(TR.tgC)&&!idx.get(TR.tgC).ch.length?TR.tgC:null;
    if(!cp)for(const lid of r.links){const n=idx.get(lid);if(n&&!n.ch.length){cp=n.id;break}}
    for(const x of (TR.exMap.get(id)||[]))x.src=x.src.filter(i=>i!==id);
    const o=mkO(orderFromRow(r,{cp}));if(!first)first=o;c++}
  TR.exSel.clear();afterMove(first?[first]:[],'Создано заказных строк из Excel: '+c)}

/* ---------- экспорт ---------- */
function dl(name,rows){
  const csv='﻿'+rows.map(r=>r.map(c=>'"'+String(c==null?'':c).replace(/"/g,'""')+'"').join(';')).join('\r\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download=name;document.body.appendChild(a);a.click();a.remove()}
function exportRows(onlyNew){
  const rows=[['Позиция договора','№','Код 1С','Артикул','Производитель','Наименование','Ед.','Кол-во','Комментарий','Тип','№ строк Excel','Согласовано']];let num=0;
  const pathOf=n=>{const p=[];let x=n;while(x){p.unshift(x.name);x=x.p?idx.get(x.p):null}return p.join(' / ')};
  const emit=(list,path,d,pre)=>{list.forEach((o,i)=>{const lbl=d===0?String(++num):pre+'.'+(i+1);
    if(!onlyNew||o.isNew)rows.push([path,lbl,o.isNew?'':o.code,o.art,o.manuf,o.name,o.unit,o.qty,o.comment||'',o.isNew?'НОВАЯ (нет в 1С)':(o.kind==='g'?'группа':''),o.src.map(id=>S.rows[id].n).join(', '),(oRaw(o)&&ackValid(o))?o.ack.text:'']);
    const k=TR.kids.get(o.id);if(k)emit(k,path,d+1,lbl)})};
  for(const n of TR.terms)emit(TR.byCp.get(n.id)||[],pathOf(n),0,'');
  emit(TR.byCp.get('_')||[],'— без договорной позиции —',0,'');return rows}

/* ---------- поиск с подстановкой в ячейках «Артикул» и «Наименование» ---------- */
function acShow(inp){
  const row=inp.closest('.rr');if(!row)return;
  const items=catFind(inp.value,12),p=$('acpop');
  TR.ac={oid:row.dataset.o,items,i:-1,inp};
  p.innerHTML=(items.length?'<div class="ah">Справочник 1С: выберите позицию (↑↓ Enter) или оставьте введённое</div>':'<div class="ah">Не найдено в справочнике 1С — позиция останется «новой»</div>')+
    items.map((it,k)=>`<div class="ai" data-k="${k}"><span class="mono">${it.code}</span><span class="mono">${esc(it.art)}</span><span title="${esc(it.name)}">${esc(it.name)}</span><span>${esc(it.unit)}</span><span>${esc(it.manuf)}</span></div>`).join('');
  p.classList.remove('hidden');
  const r=inp.getBoundingClientRect(),h=Math.min(300,items.length*28+30);
  let top=r.bottom+2;if(top+h>innerHeight-8)top=Math.max(8,r.top-h-2);
  p.style.left=Math.max(8,Math.min(r.left,innerWidth-Math.min(600,innerWidth*.94)-8))+'px';p.style.top=top+'px'}
function acHide(){TR.ac=null;$('acpop').classList.add('hidden')}
function acMark(){const p=$('acpop');p.querySelectorAll('.ai').forEach((x,k)=>x.classList.toggle('on',k===TR.ac.i));const el=p.querySelector('.ai.on');if(el&&el.scrollIntoView)el.scrollIntoView({block:'nearest'})}
function acPick(it){
  const o=TR.ac&&TR.OM.get(TR.ac.oid);if(!o||!it){acHide();return}
  o.was={art:o.art,name:o.name,code:o.code,isNew:!!o.isNew};
  Object.assign(o,{isNew:false,code:it.code,art:it.art,manuf:it.manuf,name:it.name});
  acHide();relayout();toast('Выбрано из 1С: '+it.art+(o.src.length?' · связи с Excel сохранены ('+o.src.length+')':''))}
$('acpop').addEventListener('mousedown',e=>{e.preventDefault();const a=e.target.closest('.ai');if(a&&TR.ac)acPick(TR.ac.items[+a.dataset.k])});

/* ---------- события ---------- */
