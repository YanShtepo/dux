  if(f==='art'||f==='name')acShow(e.target);else if(TR.ac)acHide()});
TV.addEventListener('focusout',()=>{setTimeout(()=>{if(TR.ac&&document.activeElement!==TR.ac.inp)acHide()},120)});
TV.addEventListener('keydown',e=>{
  if(!TR.ac)return;const L=TR.ac.items.length;
  if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();if(!L)return;const d=e.key==='ArrowDown'?1:-1;TR.ac.i=TR.ac.i<0?(d>0?0:L-1):(TR.ac.i+d+L)%L;acMark()}
  else if(e.key==='Enter'&&TR.ac.i>=0){e.preventDefault();acPick(TR.ac.items[TR.ac.i])}
  else if(e.key==='Escape'){acHide();e.stopPropagation()}});
window.addEventListener('resize',()=>{if(TR.ac)acHide()});
TV.addEventListener('click',e=>{
  if(e.target.closest('[data-cmd]'))return;
  const rr=e.target.closest('.rr');
  if(rr&&!e.target.closest('input[data-f]:not([type=checkbox]),button')){
    const oid=rr.dataset.o;
    if(e.target.closest('.rn')||e.target.closest('.rk')){selToggle(oid,e.shiftKey)}
    if(TR.selO!==oid){setSel(oid);paintSel();updateInfo();updateBar()}
