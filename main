  if(t.classList.contains('rr')){moveInto(TR.OM.get(t.dataset.o))}
  else{TR.tgC=t.dataset.c;doLink()}});
/* единая диспетчеризация команд */
document.addEventListener('click',e=>{
  const c=e.target.closest('[data-cmd]');if(!c||!$('tab-eng').contains(c))return;
  const cmd=c.dataset.cmd,row=c.closest('.rr'),o=row&&TR.OM.get(row.dataset.o),selO=TR.selO&&TR.OM.get(TR.selO);
  switch(cmd){
    case 'cg':{const id=c.dataset.c;TR.cc.has(id)?TR.cc.delete(id):TR.cc.add(id);relines();break}
    case 'xp':{const n=idx.get(c.dataset.c);TR.xo.set(n.id,!xOpen(n));relines();break}
    case 'free':{TR.freeOpen=!TR.freeOpen;if(TR.mode!=='all'){TR.mode='all';$('tMode').value='all'}relines();break}
    case 'og':{if(o){TR.oc.has(o.id)?TR.oc.delete(o.id):TR.oc.add(o.id);relines()}break}
    case 'grp':{if(o)(o.kind==='g'?ungroup(o):makeGroup(o));break}
    case 'addc':{if(o)addKid(o);break}
    case 'into':{if(o)moveInto(o);break}
    case 'out':{if(o)takeOut(o);break}
    case 'del':{if(o)delOrder(o);break}
    case 'addnew':{addBlank(c.dataset.c);break}
    case 'addrow':{const n=TR.tgC&&idx.get(TR.tgC);addBlank(n&&!n.ch.length?n.id:null);break}
    case 'ackb':{const n=idx.get(c.dataset.c);ackBulk(blockOrders(n.id),'Позиция «'+n.name+'»');break}
    case 'jump':{scrollToOrder(c.dataset.o);setSel(c.dataset.o);paintSel();updateInfo();TR.flash=new Set([c.dataset.o]);draw();setTimeout(()=>{TR.flash=new Set();draw()},2300);break}
    case 'selpile':{TR.sel=new Set(TR.lines.filter(l=>l.r&&l.r.t==='o'&&l.r.d===0&&!cpOf(l.r.o)).map(l=>l.r.o.id));draw();updateBar();break}
    case 'mkpos':mkPos(c.dataset.c);break;
    case 'mkx1':mkEx1(+c.dataset.x);break;
    case 'link':doLink();break;case 'linkseq':doLinkSeq();break;case 'unlink':doUnlink();break;case 'mkgrp':mkGroupFromSel();break;
    case 'selnone':{TR.sel.clear();draw();updateBar();break}
    case 'xnone':{TR.exSel.clear();draw();updateBar();break}
    case 'attach':attachExcel();break;case 'mkx':makeFromExcel();break;
    case 'pickn':{const s=prompt('Номера заказных строк (как в колонке №), например: 1-5, 60-70','1-5, 60-70');if(!s)break;
      let k=0;for(const part of s.split(/[,;\s]+/)){const m=part.match(/^(\d+)(?:-(\d+))?$/);if(!m)continue;const a=+m[1],b=m[2]?+m[2]:a;for(let i=a;i<=b;i++){const id=TR.num[i];if(id){TR.sel.add(id);k++}}}
      draw();updateBar();toast('Выделено заказных строк: '+k);break}
    case 'expand':{TR.cc.clear();for(const n of TR.terms)TR.xo.set(n.id,true);TR.oc.clear();relines();break}
    case 'collapse':{(function w(ns){for(const n of ns){if(n.ch.length){TR.cc.add(n.id);w(n.ch)}}})(S.roots);for(const n of TR.terms)TR.xo.set(n.id,false);TR.O.forEach(x=>{if(x.kind==='g')TR.oc.add(x.id)});TR.freeOpen=false;relines();break}
    case 'autolink':{TR.O.forEach(o=>{if(!o.cp)o.noauto=false});autoLink();break}
    case 'prefill':{const r=prefillMore();autoLink(true);relayout();toast(`Добавлено заказных по артикулам: ${fmt(r.c)} · без артикула в 1С: ${fmt(r.miss)}`);break}
    case 'ackdoc':ackBulk(TR.O,'Весь документ');break;
    case 'csv':{dl('zakaznaya_spec.csv',exportRows(false));break}
    case 'csvnew':{const r=exportRows(true);if(r.length===1){toast('Новых позиций нет');break}dl('new_for_1c.csv',r);toast('Выгружено позиций для создания в 1С: '+(r.length-1));break}
    case 'demo':{if(S.roots.length&&!confirm('Договорная будет заменена примером (одна группа из 15 строк). Продолжить?'))break;demoContract();break}
    /* панель выбранной заказной */
    case 'fix':{if(selO){const m=mult(selO);if(m){selO.qty=Math.round(srcSum(selO)/m*1e4)/1e4;relayout()}}break}
    case 'ack':{if(selO){const t=askAck('Почему расхождение допустимо? (например: запас на монтаж, остаток допоставят позже)');if(t){selO.ack={text:t,sig:oSig(selO)};relayout();toast('Расхождение согласовано')}}break}
    case 'ackclr':{if(selO){delete selO.ack;relayout()}break}
    case 'det':{TR.det=!TR.det;updateInfo();break}
    case 'cdet':{TR.cdet=!TR.cdet;updateInfo();break}
    case 'tgclr':{TR.tgC=null;draw();updateBar();updateInfo();break}
    case 'dxsel':{const id=+c.dataset.x;TR.exSel.has(id)?TR.exSel.delete(id):TR.exSel.add(id);updateBar();break}
    case 'selclr':{setSel(null);paintSel();updateInfo();draw();break}
    case 'dtfind':jumpToExcel(+c.dataset.x);break;
    case 'dtdel':{if(selO){selO.src=selO.src.filter(i=>i!==+c.dataset.x);relayout();toast('Строка Excel отвязана от заказной')}break}
  }});
function demoContract(){
  resetAll();
  const g=addChild(null,mkNode({kind:'g',name:'Система оповещения (пример)'}));
  const names=['Центральный коммутатор ARMTELICS','Модуль контроля линий NCU','Модуль реле NCU-REL','Усилитель мощности TDA','Пульт диспетчерский TOP-DIS','Громкоговоритель рупорный AR','Блок питания 12В','Аккумулятор 12В','Кабель КПСЭнг(A)-FRLS','Короб пластиковый кабельный','Лоток перфорированный','Шкаф телекоммуникационный','Шина заземления','Светильник аварийный','Дюбель-гвоздь'];
  names.forEach((nm,i)=>addChild(g,mkNode({name:nm,unit:(i>=8&&i<=10)?'м':'шт.',qty:5+i*3})));
  S.exp.add(g.id);afterChange();validate();relayout();toast('Собрана договорная: группа из 15 строк. Выделите заказные (кнопка «№…») и свяжите с позициями')}
function tOpen(){
  const c=prefill();validate();const l=autoLink(true);relayout();
  if(c)toast(`Заказная предзаполнена по артикулам: ${fmt(c)} строк, связано с договором автоматически: ${fmt(l)}`)}

/* ===================== TAB 3: вид договора ===================== */
function renderPrev(){
  let lines=[],hiddenCnt=0,num=0,LIM=500;
  (function walk(nodes,d){for(const n of nodes){
    if(n.hidden){hiddenCnt+=1;continue}
    if(lines.length>=LIM)return;
    const kids=n.ch.length&&!n.hideKids;
    lines.push({n,d,g:n.ch.length>0||n.kind==='g'&&!n.rows.length,num:++num});
    if(n.ch.length&&n.hideKids)hiddenCnt+=n.ch.length;
    if(kids)walk(n.ch,d+1);
  }})(S.roots,0);
  $('pv').innerHTML=`<table><thead><tr><th style="width:60px">№</th><th>Наименование</th><th style="width:70px">Ед.</th><th style="width:90px">Кол-во</th><th style="width:150px">Состав (скрыт в договоре)</th></tr></thead><tbody>
  ${lines.map(l=>{const n=l.n,hasKids=n.ch.length>0;return `<tr class="${hasKids?'g':''}"><td>${l.num}</td><td style="padding-left:${10+l.d*20}px">${esc(n.name)}</td><td>${hasKids?'':esc(n.unit)}</td><td>${hasKids?'':n.qty}</td><td style="color:var(--muted);font-size:12px">${(n.hideKids&&hasKids)?cntRec(n)+' стр. Excel / '+n.ch.length+' поз. скрыто':(!hasKids&&n.rows.length>1?n.rows.length+' стр. Excel внутри':'')}</td></tr>`}).join('')||'<tr><td colspan="5" style="padding:20px;color:var(--faint)">Договорная пуста</td></tr>'}</tbody></table>
  <div class="hint">Так позиции увидит заказчик. Скрытых строк, вошедших в итоги: ${fmt(hiddenCnt)}${lines.length>=LIM?` · показаны первые ${LIM} строк`:''}</div>`;
}

/* ===================== TABS ===================== */
function closeFull(){document.querySelectorAll('.pane.full').forEach(p=>p.classList.remove('full'));document.querySelectorAll('[data-full]').forEach(b=>b.textContent='⤢ На весь экран')}
document.addEventListener('click',e=>{
  const b=e.target.closest('[data-full]');if(!b)return;
  const p=b.closest('.pane'),on=!p.classList.contains('full');closeFull();
  if(on){p.classList.add('full');b.textContent='⤡ Свернуть (Esc)'}
  setTimeout(()=>{if(S.tab==='mark')renderVL();else if(S.tab==='eng')draw()},30);
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!TR.ac)closeFull()});
document.querySelector('.tabs').addEventListener('click',e=>{
  const b=e.target.closest('.tab');if(!b)return;
  closeFull();S.tab=b.dataset.tab;
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t===b));
  ['mark','eng','prev'].forEach(k=>{const m=$('tab-'+k);m.classList.toggle('hidden',k!==S.tab);if((k==='prev'||k==='eng')&&k===S.tab)m.style.display='flex'});
  if(S.tab==='mark'){renderVL();updateStats()}
  if(S.tab==='eng')tOpen();
  if(S.tab==='prev')renderPrev();
});

/* ===================== INIT ===================== */
renderTree();updateStats();refreshView();updateSelbar();

</script>
